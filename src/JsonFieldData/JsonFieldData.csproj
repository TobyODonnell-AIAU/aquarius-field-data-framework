<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net472;net10.0</TargetFrameworks>
    <AssemblyName>JsonFieldData</AssemblyName>
    <RootNamespace>JsonFieldData</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Deterministic>true</Deterministic>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <!-- NU1702: FieldDataPluginFramework.dll is a net472-only assembly referenced directly during migration — expected and acceptable -->
    <NoWarn>$(NoWarn);NU1702</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- 'Private' needed for net10 - FieldDataPluginFramework already loaded into the Default
         AssemblyLoadContext, a second reference fails with an InvalidCastException. -->
    <Reference Include="FieldDataPluginFramework" Condition="'$(TargetFramework)' == 'net10.0'">
      <HintPath>..\Library\FieldDataPluginFramework.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="FieldDataPluginFramework" Condition="'$(TargetFramework)' == 'net472'">
      <HintPath>..\Library\FieldDataPluginFramework.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ServiceStack.Text" Version="10.0.4" />
  </ItemGroup>

  <!-- net472-only polyfill packages — all of these are inbox on net10.0 -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <PackageReference Include="System.Buffers" Version="4.6.1" />
    <PackageReference Include="System.Memory" Version="4.6.3" />
    <PackageReference Include="System.Numerics.Vectors" Version="4.6.1" />
    <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="6.1.2" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Readme.md" />
    <None Include="data\**\*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FieldDataPluginFramework.Serialization\FieldDataPluginFramework.Serialization.csproj" />
  </ItemGroup>

  <!-- net472: PluginPackager.exe/PluginTester.exe are net472-only tools that load the plugin assembly
       via reflection in-process, so they can only package/test the net472 build.
       Guarded by Exists() so building this project standalone (without building the whole solution
       and its tool projects first) doesn't hard-fail. -->
  <Target Name="PackageAndTestNet472Plugin" AfterTargets="Build" Condition="'$(TargetFramework)' == 'net472' And Exists('$(SolutionDir)PluginPackager\bin\$(Configuration)\PluginPackager.exe') And Exists('$(SolutionDir)PluginTester\bin\$(Configuration)\net472\PluginTester.exe')">
    <Exec Command="&quot;$(SolutionDir)PluginPackager\bin\$(Configuration)\PluginPackager.exe&quot; &quot;$(TargetPath)&quot; /OutputPath=&quot;$(ProjectDir)deploy\$(Configuration)\$(TargetName).plugin&quot; /Exclude=*.json.json" />
    <Exec Command="&quot;$(SolutionDir)PluginTester\bin\$(Configuration)\net472\PluginTester.exe&quot; /Plugin=&quot;$(TargetPath)&quot; /Data=&quot;$(ProjectDir)data\*.json&quot; /Json=&quot;$(TargetDir.TrimEnd('\'))&quot;" />
  </Target>

  <!-- net10.0: PluginPackager can't load a net10.0 assembly (net472 process), so stage the plugin
       output plus a manifest.json (matching PluginPackager's schema) and zip it directly. -->
  <Target Name="PackageNet10Plugin" AfterTargets="Build" Condition="'$(TargetFramework)' == 'net10.0'">
    <PropertyGroup>
      <Net10PluginStagingDir>$(IntermediateOutputPath)plugin-staging\</Net10PluginStagingDir>
      <Net10PluginPackagePath>$(ProjectDir)deploy\$(Configuration)\$(TargetName)-net10.plugin</Net10PluginPackagePath>
    </PropertyGroup>

    <RemoveDir Directories="$(Net10PluginStagingDir)" Condition="Exists('$(Net10PluginStagingDir)')" />
    <MakeDir Directories="$(Net10PluginStagingDir)" />
    <MakeDir Directories="$(ProjectDir)deploy\$(Configuration)" />

    <ItemGroup>
      <Net10PluginOutputFiles Include="$(OutDir)**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(Net10PluginOutputFiles)" DestinationFolder="$(Net10PluginStagingDir)%(RecursiveDir)" />

    <WriteLinesToFile
        File="$(Net10PluginStagingDir)manifest.json"
        Lines="{&#xA;    &quot;AssemblyQualifiedTypeName&quot;: &quot;JsonFieldData.Plugin, JsonFieldData, Version=1.0.0.0, Culture=neutral, PublicKeyToken=null&quot;,&#xA;    &quot;Description&quot;: &quot;The JsonFieldData plugin&quot;,&#xA;    &quot;PluginFolderName&quot;: &quot;JsonFieldData&quot;&#xA;}"
        Overwrite="true" />

    <Delete Files="$(Net10PluginPackagePath)" Condition="Exists('$(Net10PluginPackagePath)')" />
    <ZipDirectory SourceDirectory="$(Net10PluginStagingDir)" DestinationFile="$(Net10PluginPackagePath)" Overwrite="true" />
  </Target>
</Project>